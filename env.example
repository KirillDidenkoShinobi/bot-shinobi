BOT_TOKEN=PASTE_NEW_TELEGRAM_BOT_TOKEN_HERE
SHINOBI_STATS_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
TECH_ADMIN_PASSWORD=CHANGE_ME_TECH_PASSWORD
SESSION_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
# Локально можно оставить 8080. На Railway PORT задаётся автоматически.
SHINOBI_STATS_PORT=8080

# Railway PostgreSQL. В Railway лучше подключить через Reference Variable.
DATABASE_URL=postgresql://user:password@host:5432/database

# Public HTTPS URL of the web dashboard used by Telegram Web App button.
# Example: https://your-project.up.railway.app/dashboard
SHINOBI_WEBAPP_URL=

# Separate code required by the web panel before generating a full bot/database ZIP backup.
BACKUP_EXPORT_CODE=CHANGE_ME_BACKUP_DOWNLOAD_CODE

# AI providers. Gemini is fallback for moderation and primary for casual AI replies.
# Keep secrets only in Railway Variables — never commit real keys here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODERATION_MODEL=gemini-3.5-flash-lite
AI_REPLY_GROQ_MODEL=openai/gpt-oss-20b
AI_CONTEXT_MESSAGES=20
AI_MAX_OUTPUT_TOKENS=120

# AI moderation BETA: Groq primary -> Gemini fallback -> fail-open
GROQ_API_KEY=
AI_MODERATION_ENABLED=1
AI_MODERATION_MODEL=openai/gpt-oss-20b
AI_MODERATION_MIN_CONFIDENCE=0.88
AI_MODERATION_TIMEOUT=25
AI_MODERATION_MAX_TEXT=1000

# Social context used by AI moderation
AI_MODERATION_CONTEXT_MESSAGES=8
AI_MODERATION_CONTEXT_TTL=1800

# IDs of additional administrators to notify via private messages (comma-separated).
SHINOBI_ADMIN_IDS=
